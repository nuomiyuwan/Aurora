{
  "name": "aurora-project-library-prototype",
  "private": true,
  "version": "1.1.0",
  "description": "Aurora cinematic project library prototype",
  "author": "nuomiyuwan",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuomiyuwan/Aurora.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "test": "playwright test",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "media-tools:mac:arm64": "bash scripts/build-ffmpeg-macos-arm64.sh",
    "media-tools:mac:x64": "arch -x86_64 bash scripts/build-ffmpeg-macos-x64.sh",
    "preview": "vite preview",
    "package:mac": "npm run package:mac:arm64:installer",
    "package:mac:arm64": "npm run package:mac:arm64:installer",
    "package:mac:arm64:dir": "npm run build && node scripts/package-macos.cjs arm64 dir",
    "package:mac:arm64:installer": "npm run build && node scripts/package-macos.cjs arm64 installer",
    "package:mac:x64:installer": "npm run build && node scripts/package-macos.cjs x64 installer",
    "package:win": "npm run package:win:dir",
    "package:win:dir": "npm run build && electron-builder --win --x64 --dir",
    "package:win:installer": "npm run build && electron-builder --win --x64",
    "package:all": "npm run package:mac && npm run package:win"
  },
  "build": {
    "appId": "local.aurora-project-library",
    "productName": "Aurora",
    "publish": [
      {
        "provider": "github",
        "owner": "nuomiyuwan",
        "repo": "Aurora"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "toolsets": {
      "nsis": "1.2.1",
      "wine": "1.0.1"
    },
    "fileAssociations": [
      {
        "ext": [
          "3g2",
          "3gp",
          "asf",
          "avi",
          "f4v",
          "flv",
          "m2ts",
          "m2v",
          "m4v",
          "mkv",
          "mov",
          "mp4",
          "mpeg",
          "mpg",
          "mts",
          "mxf",
          "ogv",
          "rm",
          "rmvb",
          "ts",
          "vob",
          "webm",
          "wmv"
        ],
        "name": "Video",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "Aurora-macOS-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "resources/bin/mac-${arch}",
          "to": "bin",
          "filter": [
            "ffmpeg",
            "ffprobe"
          ]
        },
        {
          "from": "resources/ffmpeg",
          "to": "licenses/ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "resources/bin/windows-x64",
          "to": "bin",
          "filter": [
            "ffmpeg.exe",
            "ffprobe.exe"
          ]
        },
        {
          "from": "resources/ffmpeg/windows-x64",
          "to": "licenses/ffmpeg",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Aurora-Windows-${version}-${arch}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@types/three": "^0.185.0",
    "jpeg-js": "^0.4.4",
    "lucide-react": "^1.21.0",
    "pngjs": "^7.0.0",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  }
}
